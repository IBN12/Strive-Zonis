NODE_ENV="development"
PORT=3000

# Must match the address the game is loaded from (Electron loads the server itself)
CLIENT_ORIGIN="http://localhost:3000"

DATABASE_URL="postgresql://strive_app:something_here@localhost:5432/strive_zonis"

SESSION_SECRET="replace_me"
BCRYPT_ROUNDS=12

USE_REDIS="false"
REDIS_URL="redis://localhost:6379"