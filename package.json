{
  "name": "strive-zonis",
  "version": "1.0.0",
  "description": "Strive Zonis: We Are Zonis",
  "main": "electron-main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "node --watch server",
    "start": "node server.js",
    "db:migrate": "psql -h localhost -U postgres -d strive_zonis -f db/schema.sql",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IBN12/Strive-Zonis.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/IBN12/Strive-Zonis/issues"
  },
  "homepage": "https://github.com/IBN12/Strive-Zonis#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.isom.strivezonis",
    "productName": "Strive Zonis",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "public/**/*",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md, README.md, README, readme.md, readme}",
      "!**/*.map"
    ],
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    }
  }
}
